{
  "name": "kafka-orders-frontend",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\"",
    "generate:api": "turbo run generate:api --filter=@poc/orders --filter=@poc/payment --filter=@poc/notification --filter=@poc/inventory",
    "fetch:openapi": "node ./scripts/fetch-openapi.mjs",
    "sync:api": "npm run fetch:openapi && npm run generate:api"
  },
  "devDependencies": {
    "@rtk-query/codegen-openapi": "^2.2.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20"
  }
}
