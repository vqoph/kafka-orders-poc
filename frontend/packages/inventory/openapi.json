{
  "openapi": "3.0.3",
  "info": {
    "title": "inventory-service",
    "version": "0.0.1"
  },
  "servers": [{ "url": "http://localhost:8085" }],
  "paths": {
    "/stock": {
      "get": {
        "operationId": "listStock",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/StockResponse" }
                }
              }
            }
          }
        }
      }
    },
    "/stock/{sku}": {
      "get": {
        "operationId": "getStock",
        "parameters": [
          {
            "name": "sku",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StockResponse" }
              }
            }
          }
        }
      }
    },
    "/chaos/failure-rate": {
      "get": {
        "operationId": "getInventoryFailureRate",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FailureRateResponse" }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "setInventoryFailureRate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FailureRateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FailureRateResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StockResponse": {
        "type": "object",
        "required": ["sku", "quantity"],
        "properties": {
          "sku": { "type": "string" },
          "quantity": { "type": "integer" }
        }
      },
      "FailureRateRequest": {
        "type": "object",
        "required": ["rate"],
        "properties": {
          "rate": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      },
      "FailureRateResponse": {
        "type": "object",
        "required": ["rate"],
        "properties": {
          "rate": { "type": "number" }
        }
      }
    }
  }
}
