{
  "openapi": "3.0.3",
  "info": {
    "title": "payment-service",
    "version": "0.0.1"
  },
  "servers": [{ "url": "http://localhost:8082" }],
  "paths": {
    "/chaos/failure-rate": {
      "get": {
        "operationId": "getPaymentFailureRate",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FailureRateResponse" }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "setPaymentFailureRate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FailureRateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FailureRateResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FailureRateRequest": {
        "type": "object",
        "required": ["rate"],
        "properties": {
          "rate": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      },
      "FailureRateResponse": {
        "type": "object",
        "required": ["rate"],
        "properties": {
          "rate": { "type": "number" }
        }
      }
    }
  }
}
