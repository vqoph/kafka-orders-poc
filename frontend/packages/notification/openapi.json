{
  "openapi": "3.0.3",
  "info": {
    "title": "notification-service",
    "version": "0.0.1"
  },
  "servers": [{ "url": "http://localhost:8084" }],
  "paths": {
    "/notifications": {
      "get": {
        "operationId": "listNotifications",
        "parameters": [
          {
            "name": "orderId",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/NotificationEvent" }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NotificationEvent": {
        "type": "object",
        "required": ["type", "message", "at"],
        "properties": {
          "orderId": { "type": "string", "format": "uuid", "nullable": true },
          "type": { "type": "string" },
          "message": { "type": "string" },
          "at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
