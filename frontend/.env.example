# Copy to .env and adjust if your local ports differ.

# OpenAPI specs (npm run fetch:openapi)
ORDERS_OPENAPI_URL=http://localhost:8081/v3/api-docs
PAYMENT_OPENAPI_URL=http://localhost:8082/v3/api-docs
NOTIFICATION_OPENAPI_URL=http://localhost:8084/v3/api-docs
INVENTORY_OPENAPI_URL=http://localhost:8085/v3/api-docs

# Runtime API bases (webpack DefinePlugin → remotes)
ORDERS_API_BASE_URL=http://localhost:8081
PAYMENT_API_BASE_URL=http://localhost:8082
NOTIFICATION_API_BASE_URL=http://localhost:8084
INVENTORY_API_BASE_URL=http://localhost:8085
